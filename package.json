{
  "name": "thomas-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "assets": "node scripts/generate-assets.mjs",
    "seo": "node scripts/generate-seo-files.mjs",
    "screenshots": "node scripts/generate-screenshots.mjs",
    "build": "npm run assets && npm run seo && vite build && node scripts/generate-pdfs.mjs",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.1.1",
    "@fontsource-variable/jetbrains-mono": "^5.1.2",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.17.2",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "playwright": "^1.50.1",
    "sharp": "^0.33.5",
    "svelte": "^5.20.5",
    "svelte-check": "^4.1.4",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
